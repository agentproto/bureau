{
  "name": "@agentproto/bureau-sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentproto/bureau.git",
    "directory": "packages/sdk"
  },
  "description": "Typed client for a Bureau capability server: sessions, tabs and live snapshots over an injected transport",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bureau",
    "browser",
    "sdk",
    "mcp"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Agentik",
  "homepage": "https://github.com/agentproto/bureau#readme",
  "bugs": {
    "url": "https://github.com/agentproto/bureau/issues"
  }
}
