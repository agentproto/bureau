{
  "name": "@agentproto/bureau-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentproto/bureau.git",
    "directory": "packages/core"
  },
  "description": "Bureau core: browser driver port, sessions, recordings, notifier and page-eval contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js",
      "default": "./dist/driver.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js",
      "default": "./dist/notify.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js",
      "default": "./dist/recorder.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js",
      "default": "./dist/artifacts.js"
    },
    "./page-eval": {
      "types": "./dist/page-eval.d.ts",
      "import": "./dist/page-eval.js",
      "default": "./dist/page-eval.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Bureau contributors",
  "homepage": "https://github.com/agentproto/bureau#readme",
  "bugs": {
    "url": "https://github.com/agentproto/bureau/issues"
  }
}
